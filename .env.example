# Copy to .env.local (gitignored) for local development.
#
# These are inlined into the bundle at BUILD time by Create React App. On Netlify they
# are the site's environment variables, and a change to any of them needs a redeploy
# before it takes effect.
#
# The anon key belongs here: it is public by design, ships in the bundle either way, and
# is useless without the row-level policies behind it. The SERVICE key does not belong
# here, or anywhere under src/ — it lives only in the Netlify functions' environment.

REACT_APP_SITE_URL=http://localhost:3000
REACT_APP_SUPABASE_URL=https://kemxayrrvltvthfnvkuf.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# Optional. Without it, push notifications are unavailable rather than broken.
REACT_APP_VAPID_PUBLIC=
